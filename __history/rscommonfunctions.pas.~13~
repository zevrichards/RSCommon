Procedure LogUpdate(status, log: string);
var slFile: TStringList;
begin
    slFile := TstringList.Create;
    try
      If not FileExists(log) then
        slFile.Text := GetAppVersionStr(ParamStr(0)) + ' ' + DateTimeToStr(Now)+': '+status+sLineBreak
      else
      begin
        slFile.LoadFromFile(log);
        slFile.Text := slFile.Text+ GetAppVersionStr(ParamStr(0)) + ' ' + DateTimeToStr(Now)+': '+status+sLineBreak;
      end;
      slFile.SaveToFile(log);
    finally
      slFile.Free;
    end;
end;

{https://stackoverflow.com/questions/988733/how-to-delete-files-matching-pattern-within-a-directory}
procedure DeleteFiles(APath, AFileSpec: string);
var
  lSearchRec:TSearchRec;
  lPath:string;
begin
  lPath := IncludeTrailingPathDelimiter(APath);

  if FindFirst(lPath+AFileSpec,faAnyFile,lSearchRec) = 0 then
  begin
    try
      repeat
        SysUtils.DeleteFile(lPath+lSearchRec.Name);
      until SysUtils.FindNext(lSearchRec) <> 0;
    finally
      SysUtils.FindClose(lSearchRec);  // Free resources on successful find
    end;
  end;
end;

function ReplaceXMLEntry (const FileToSearch, OldText, NewText: string): boolean;
var slFiletoSearch: TStringList;
begin
   slFiletoSearch := TStringList.Create;
    try
       slFiletoSearch.LoadFromFile(FileToSearch);    //load file to make changes
       slFiletoSearch.Text := StringReplace(slFiletoSearch.Text, OldText, NewText, [rfReplaceAll, rfIgnoreCase]);     //replace all occurences ignoring case
       slFiletoSearch.SaveToFile(FileToSearch);    //save and free
       slFiletoSearch.Free;
       result := true
    except
       slFileToSearch.Free;   //free on error
       result := false;
    end;
end;

function DetectInstalledSims: TArray<integer>;
var x: integer;
    myReg : TRegistry;

begin

  //scan for installed sims
  For x:= 0 to 7 do
  begin
    myReg := TRegistry.Create(KEY_READ OR KEY_WOW64_64KEY);
    try
      myReg.RootKey := HKEY_LOCAL_MACHINE;
      if myReg.KeyExists(simkeys64[x]) = true then
      begin
        setlength(result, length(result)+1);
        result[length(result)-1] := x;
      end
      else
      begin
        if myReg.OpenKeyReadOnly(simkeys32[x]) = true then
        begin
          setlength(result, length(result)+1);
          result[length(result)-1] := x;
        end;
      end;
    finally
      myReg.Free;
    end;
  end;
  If FileExists(GetEnvironmentVariable('LOCALAPPDATA')+'\x-plane_install_11.txt') then
  begin
    setlength(result, length(result)+1);
    result[length(result)-1] := 6;
  end;

end;

function GetSimPath(simkey64,simkey32: string): string;
var myReg : TRegistry;
    SL: TStringList;
    aFileOpenDialog : TFileOpenDialog;

begin
  result := '';
  If ContainsText(simkey64, 'x-plane_install_11.txt') then
  begin

    SL := TStringList.Create;
    try
      SL.LoadFromFile(GetEnvironmentVariable('LOCALAPPDATA')+'\x-plane_install_11.txt');
      If SL.Count = 1 then
        result := trim(SL.Strings[0])
      else
      begin
        MessageDlg('Multiple X-Plane 11 installations detected. Please select the correct folder.', mtError, [mbOk], 0);
        aFileOpenDialog := TFileOpenDialog.Create(nil);
        aFileOpenDialog.Options := [fdoPickFolders];
        If aFileOpenDialog.Execute() then
          result := aFileOpenDialog.FileName+'\';
      end;
      If result[length(result)] <> '\' then
      begin
        If result[length(result)] <> '/' then
          result := result+'\';
      end;
    finally;
      SL.Free;
    end;

  end
  else
  begin
    myReg := TRegistry.Create(KEY_READ OR KEY_WOW64_64KEY);
    try
      myReg.RootKey := HKEY_LOCAL_MACHINE;
      if myReg.OpenKeyReadOnly(simkey64) then
      begin
        result := myReg.ReadString('SetupPath');
        result := StringReplace(result, #0, '',[rfReplaceAll]);
        if length(result) > 0 then
          If result[Length(result)] <> '\' then result := result + '\';
      end
      else
      begin
          if myReg.OpenKeyReadOnly(simkey32) then
          begin
            result := myReg.ReadString('SetupPath');
            result := StringReplace(result, #0, '',[rfReplaceAll]);
            if length(result) > 0 then
              If result[Length(result)] <> '\' then result := result + '\';
          end;
      end;
      myReg.CloseKey
    finally
      myReg.Free;
    end;
  end;
end;

function FindInstallLocation(SceneryName, sceneryCFGPath, simpath, sim: string): string;
var SL: TStringList;
    x: integer;
    S, v: string;
    FoundAddOnXMLs: Tarray<String>;
begin

  v := Sim[High(Sim)];
  result:='';
  SL := TStringList.Create;

  If sim = 'xp11' then
  begin

    try
      If FileExists(sceneryCFGPath+'scenery_packs.ini') then
      begin
       SL.LoadFromFile (sceneryCFGPath+'scenery_packs.ini');

       For x := 0 to SL.Count-1 do
       begin
         If SL.Strings[x].Contains(SceneryName) then
         begin
           result := RightStr(trim(SL.Strings[x]), length(trim(SL.Strings[x]))-length('SCENERY_PACK '));
           If result[length(result)] <> '/' then
            result := result + '/';
           break;
         end;
       end;
      end;

    finally
      SL.Free;
    end;

  end
  else
  begin

    //find install location for Scenery Name, note: for p34/5, it could be in add-on folder
    try
      If FileExists(sceneryCFGPath+'scenery.cfg') then
      begin
       SL.LoadFromFile (sceneryCFGPath+'scenery.cfg');

       For x := 0 to SL.Count-1 do
       begin
         If SL.Strings[x].Contains('\'+SceneryName) then
         begin
           result := RightStr(trim(SL.Strings[x]), length(trim(SL.Strings[x]))-length('Local='))+ '\';
           If result[length(result)] <> '\' then
            result := result + '\';
           break;
         end;
       end;
      end;

    finally
      SL.Free;
    end;

    //SEARCH ALL THE ADD-ON.XMLS WE FIND IN MY DOCUMENTS\PREPAR3D ADD-ONS\
    If not isLegacySim(sim) and (result='') then
    begin

      If DirectoryExists(GetSpecialFolder(CSIDL_PERSONAL)+'Prepar3D v'+v+' Add-ons\') then
      begin
        for S in TDirectory.GetFiles(GetSpecialFolder(CSIDL_PERSONAL)+'Prepar3D v'+v+' Add-ons\', 'Add-on.xml', TSearchOption.soAllDirectories) do
          TAppender<String>.Append(FoundAddOnXMLs, S);
      end;

      For S in FoundAddOnXMLs do
      begin

        SL := TStringList.Create;
        try
         SL.LoadFromFile (S);

         For x := 0 to SL.Count-1 do
         begin
           If SL.Strings[x].Contains(SceneryName+'</Path>') then
           begin
            result := ReturnStringBetweenText('<Path>','</Path>',SL.Strings[x])+'\';
            break;
           end;
         end;
         If x <> SL.Count - 1 then

         //simpath is now P34/5 add-ons folder (in "S")
         simpath := LeftStr(S,length(S)-length('Add-on.xml'));
        finally
          SL.Free;
        end

      end;
    end;

  end;



  //if the Installation is not absolute, make it so. We assume it's in the simpath
  //Where Simpath is the full simulator path if not P34/5
  //And Addon.xml path if it is p34/5
  If result<>'' then
  begin
  If result[2] <> ':' then
   result := simpath + result;
  end;

end;

function DetectInstalledProducts(SimPath, AddonXML, sceneryCFGPath, sim: string; UseP3DAutogenSystem: boolean): TArray<Integer>;
var x, i: integer;
  SL: TStringList;
  v, s: string;
  nearbyproducts: TArray<integer>;
