function BinaryStringToDecimal(BCDString: string): integer;
var x: integer;
begin
  result := 0;
  For x := BCDString.Length downto 1 do
    result := StrToInt(BCDString[x]) * ceil(Power(2, BCDString.Length-x)) + result;
end;

function CheckforSODEInstall(SimVersion, LWCFGPath: string): int64;
var SODEInstallLocation, AddonCFGPath, SearchString, v: string;
    y: integer;
    SL: TStringList;


begin
  ////determine whether Arno's Autogen Configuration Merger is installed or not
  SODEInstallLocation := '';
  v := SimVersion[High(SimVersion)];
  AddonCFGPath := GetEnvironmentVariable('ProgramData')+'\Lockheed Martin\Prepar3D v'+v+'\Add-ons.cfg';
  //check to see whether the tool is present in the exe.xml or whether addon.xml exists

  //get addon.xml path in My Documents folder given by the following reg key
  //HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders\Personal
  If not isLegacySim(simversion) and (FileExists(AddonCFGPath) = true) then
  begin

    SL := TStringList.Create;
    try
      //search for the install path of the Tool
      SL.LoadFromFile(AddonCFGPath);
      //We will need to find the SODE entry, could be first, middle or last
      SearchString := '\SODE\P3Dv'+v;
      y := Pos(lowercase(SearchString), lowercase(SL.Text)); //this is the end of the addon.xml directory
      If y > length(SearchString) then
      begin
        While SL.Text[y+1] <> ':' do //work backwards to the drive letter
        begin
          y := y - 1;
          SODEInstallLocation := SL.Text[y] + SODEInstallLocation;
        end;
        SODEInstallLocation := SODEInstallLocation + '\SODE';
      end;
    finally
      SL.Free;
    end;

  end
  else
  begin

    SL := TStringList.Create;
    try
      If FileExists(LWCFGPath+'exe.xml') then
      begin
        //search for the install path of the Tool
        SL.LoadFromFile(LWCFGPath+'exe.xml');
        //We will need to find the SODE entry first
        SearchString := '\SODE\SimObjectDisplayEngine.exe';
        y := Pos(lowercase(SearchString), lowercase(SL.Text)); //this is the end of the addon.xml directory
        If y > length(SearchString) then
        begin
          While SL.Text[y+1] <> ':' do //work backwards to the drive letter
          begin
            y := y - 1;
            SODEInstallLocation := SL.Text[y] + SODEInstallLocation;
          end;
          SODEInstallLocation := SODEInstallLocation + searchstring;
        end;
      end;
    finally
      SL.Free;
    end;

  end;

  If SODEInstallLocation<>'' then
  begin
    If not ContainsText(SODEInstallLocation, 'SimObjectDisplayEngine.exe') then
    begin
      If SODEInstallLocation[length(SODEInstallLocation)] <>'\' then
        SODEInstallLocation :=  trim(SODEInstallLocation)+'\';
      SODEInstallLocation:= trim(SODEInstallLocation)+'SimObjectDisplayEngine.exe';
    end;
  end;


  //check to see whether the tool was actually installed at that path and retrieve its version
  If FileExists (SODEInstallLocation) then
    result := GetAppVersionInt(SODEInstallLocation)
  else
    result := 0;

end;

