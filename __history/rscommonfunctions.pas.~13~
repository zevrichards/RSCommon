                      #9'</AddOn.Component>');

            break;
          end;
        end;
      end
      else
      begin
        For x:= 1 to SL.Count-1 do
        begin
          If SL.Strings[x].Contains('<Category>Autogen</Category>') then
          begin
            For i:= 4 downto 1 do
              SL.Delete(x-1+i);
            break;
          end;
        end;
      end;

      SL.SaveToFile(AddonXML);
    finally
      SL.Free;
    end;

  end;


