Function CheckforAGNError: string;
var ErrorFile, stat: string;
    SL: TStringList;
    x,y,z: integer;
begin

  result := '';
  ErrorFile := '';
  SL := TStringList.Create;
    try
      If FileExists(GetEnvironmentVariable('AppData')+'\SceneryDesign.org\AutogenConfigurationMerger\AutogenConfigurationMerger.log') then
      begin
        try
          SL.LoadFromFile(GetEnvironmentVariable('AppData')+'\SceneryDesign.org\AutogenConfigurationMerger\AutogenConfigurationMerger.log');
          z := ReturnPosXMLEntry(GetEnvironmentVariable('AppData')+'\SceneryDesign.org\AutogenConfigurationMerger\AutogenConfigurationMerger.log', 'Error! Stopping...');
           If z>0 then
           begin
             x := z - 16; //end of filename on previous line. Start here to read file that caused the error.
             y := z + 32; //end of timestamp on next line. Start here to read error
             While SL.Text[y] <> #13 do
             begin
               result := result + SL.Text[y];
               y := y+1;
             end;

             While SL.Text[x+2] <> ':' do
                   x := x-1;
             For y := x to z-16 do
               ErrorFile := ErrorFile + SL.Text[y];

             stat := 'Autogen Configuration Merger has reported an error:'+result+' in the following file:'+ErrorFile;
             LogUpdate(stat, 'Error.log');
             MyMessageDialog('Autogen Configuration Merger has reported an error:'+#10+#13+trim(result)+#10+#13+'In the following file:'+#10+#13+trim(ErrorFile)+#10+#13+'Please email this file and error message to richersimulations@gmail.com for support.'+#10+#13+'This info has been logged in Error.log for reference.', mtError, mbOkCancel,['Ok'])// mbOKOnly,['Ok']) Need Source files to add mbOkOnly
           end
           else
           begin
             result := '';
           end;
        except
          result := '*Error accessing log file*';
          ErrorFile := '*Could not retrieve file*';
        end;
      end;

    finally
      SL.Free;
    end;
end;

function Edit_LWcfg(const {remind,} checked: boolean; sim, simpath, LWCFGpath: string{; out remindagain: boolean}): boolean;
var LWcfg, TrafficHigh, TrafficLow, log: string;
  SL: TStringList;
  ToSPB : boolean;
begin

    ToSPB := false;

    If not isLegacySim(sim) then
    begin
      TrafficHigh:= 'P3DTrafficHigh.txt';
      TrafficLow:= 'P3DTrafficLow.txt';
    end
    else
    begin
      TrafficHigh:= 'LegacyTrafficHigh.txt';
      TrafficLow:= 'LegacyTrafficLow.txt';
    end;


     //backup
    If (FileExists(LWCFGpath+'LWcfg.spb')=true) and (FileExists(LWCFGpath+'RS LWcfg Backup\LWcfg.spb.bak')=false) then
    begin
       ForceDirectories(LWCFGpath+'RS LWcfg Backup\');
       CopyFiles ( LWCFGpath+'LWcfg.spb', LWCFGpath+'RS LWcfg Backup\LWcfg.spb.bak', FOF_NOCONFIRMATION);
    end;
    If (FileExists(LWCFGpath+'LWcfg.xml')=true) and (FileExists(LWCFGpath+'RS LWcfg Backup\LWcfg.xml.bak')=false) then
    begin
       ForceDirectories(LWCFGpath+'RS LWcfg Backup\');
       CopyFiles ( LWCFGpath+'LWcfg.xml', LWCFGpath+'RS LWcfg Backup\LWcfg.xml.bak', FOF_NOCONFIRMATION);
    end;

     LWcfg:='';

     //set the full path of the LWCFG
     If FileExists(LWCFGPath+'LWcfg.xml')=true then
       //if an XML already exists
       LWcfg := LWCFGPath+'LWcfg.xml'
     else
     begin
        If FileExists(LWCFGPath+'LWcfg.spb')=true then
        begin
         ToSPB := true;  //we're handling an SPB file and will need to convert it back later.
         If RunProgramWaiting('spb2xml.exe', '', ['-s', '"'+simpath+'propdefs"', '"'+LWCFGpath+'LWcfg.spb"'], log)<>-1 then   //convert
         begin
            If FileExists(LWCFGPath+'LWcfg.xml') then
            begin
              DeleteFile (LWCFGPath+'LWcfg.spb');
              LWcfg := LWCFGPath+'LWcfg.xml';
            end;
         end;
        end;
     end;


  //load the LWCFG.xml file that we found and replace the required text.
  SL := TStringList.Create;
  SL.LoadFromFile(TrafficHigh);
  TrafficHigh := SL.Text;
  SL.Free;
  SL := TStringList.Create;
  SL.LoadFromFile(TrafficLow);
  TrafficLow := SL.Text;
  SL.Free;
     If checked = true then
      result := ReplaceXMLEntry(LWCFG, TrafficHigh, TrafficLow)
     else
      result := ReplaceXMLEntry(LWCFG, TrafficLow, TrafficHigh);

  //try to convert the xml file back to spb and delete the xml if it was originally in spb format.
  If ToSPB then
  begin
    If RunProgramWaiting('simpropcompiler.exe', '', ['2spb', '-symbols', '"'+SimPath+'propdefs\*.xml"', '"'+LWcfgPath+'LWcfg.xml"', '"'+LWcfgPath+'LWcfg.spb"'], log)<>-1 then
    begin
     If FileExists(LWCFGPath+'LWcfg.spb') then
        DeleteFile (LWCFGPath+'LWcfg.xml');
    end;
  end;


end;


