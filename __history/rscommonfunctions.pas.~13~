procedure EndianSwap(ValueIn: Pointer; Size: integer);
//http://delphi.cjcsoft.net//viewthread.php?tid=49519
var
  l: LongWord;
  w: Word;
begin
  case Size of

    2: begin
      { ValueIn is WORD-sized }
      w := PWord(ValueIn)^;
      asm
        mov ax,w;   { move w into ax register }
        xchg al,ah; { swap lo and hi byte of word }
        mov w,ax;   { move "swapped" ax back to w }
      end;
      PWord(ValueIn)^ := w;
    end;

    4: begin
      { ValueIn is DWORD-sized }
      l := PLongWord(ValueIn)^;
      asm
        mov eax,l; { move l into eax register }
        BSWAP eax; { reverse the order of bytes in eax }
        mov l,eax; { move "swapped" eax back to 1 }
      end;
      PLongWord(ValueIn)^ := l;
    end;

  end;
end;


