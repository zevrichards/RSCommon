        begin
            If pos(RSXPproducts[x], SL.text) <> 0 then
              TAppender<Integer>.Append(result, x);
        end;
      end;
    finally
      SL.free;
    end;
    //then search custom scenery for products
    For x:= 0 to length(RSXPproducts)-1 do
    begin
      If DirectoryExists(simpath+'Custom Scenery\'+RSXPproducts[x]) then
      begin
        If not TArray.BinarySearch<integer>(result, x, i) then  //if not already in the list,
        begin
          //add it so that we can add it to the scenery_pack.ini later
          TAppender<Integer>.Append(nearbyproducts, x);
          TAppender<Integer>.Append(result, x);
        end;
      end;
    end;

    If (length(nearbyproducts)>0) then
    begin
      s := '';
      For x in nearbyproducts do
        s := s + sLineBreak +#9+ RSXPproducts[x];

      If MyMessageDialog('The following products are installed but were not found in your Scenery_Packs.ini. Would you like to have them added them now?'+s, mtInformation, mbOKCancel, ['Now', 'Later']) = mrOk then
      begin
        For x in nearbyproducts do
          AddToSceneryLibrary(x, sceneryCFGPath+'scenery_packs.ini', RicherSimsLocation);
      end;
    end;

  end
  else
  begin

    //search the default scenery.cfg for products
    SL := TStringList.Create;
    try
      If FileExists(sceneryCFGPath+'scenery.cfg') then
      begin
        SL.LoadFromFile (sceneryCFGPath+'scenery.cfg');
        For x:= 0 to length(RSproducts)-1 do
        begin
            If pos(RSproducts[x], SL.text) <> 0 then
              TAppender<Integer>.Append(result, x);
        end;
      end;
    finally
      SL.free;
    end;
  //then search the my documents folder for our add-on.xml to see what prodcuts it contains
    If not isLegacySim(sim) then
    begin
      SL := TStringList.Create;
      try
        If FileExists(AddonXML) then
        begin
          SL.LoadFromFile (AddonXML);
          For x:= 0 to length(RSproducts)-1 do
          begin
            If pos(RSproducts[x]+'</Name>', SL.text) <> 0 then       //addon.xml may contain multiple hits of 'RS COmmon' so search for </Name> at the end to ensure we find an actual scenery entry
              TAppender<Integer>.Append(result, x);
          end
        end;
      finally
        SL.Free;
      end;
    end;

    //search nearby folders ../ for installed products. They should all be installed near the config folder in which this EXE resides
    For x:= 0 to length(RSproducts)-1 do
    begin
      If DirectoryExists('../'+RSproducts[x]) then
      begin
        If not TArray.BinarySearch<integer>(result, x, i) then  //if not already in the list,
        begin
          //add it so that we can add it to the Add-on.xml later
          TAppender<Integer>.Append(nearbyproducts, x);
          TAppender<Integer>.Append(result, x);
        end;
      end;
    end;

    //if the sim is not p34 then notify the user to add discovered products to the scenery library.
    If isLegacySim(sim) and (length(nearbyproducts)>0) then
    begin
      s := '';
      For x in nearbyproducts do
        s := s + sLineBreak +#9+ RSproducts[x];

      If MyMessageDialog('The following products are installed but were not found in the Scenery Library. Would you like to have them added them now?'+s, mtInformation, mbOKCancel, ['Now', 'Later']) = mrOk then
      begin
        For x in nearbyproducts do
          AddToSceneryLibrary(x, sceneryCFGPath+'scenery.cfg', RicherSimsLocation);
      end;
    end;

  end;


  If not isLegacySim(sim) then
  begin
    //create addon.xml if it does not exist
    If not FileExists(AddonXML) then
    begin
      ForceDirectories(ExtractFilePath(AddonXML));
      SL := TStringList.Create;
      try
        SL.Text :=     '<SimBase.Document Type="AddOnXml" version="4,0" id="add-on">'+
                  #13#10#9'<AddOn.Name>RS ALT files</AddOn.Name>'+
                  #13#10#9'<AddOn.Description>Altitude files for RS Airports: DO NOT EDIT OR REMOVE!</AddOn.Description>'+
                  #13#10#9'<AddOn.Component>'+
                  #13#10#9#9'<Category>Scenery</Category>'+
                  #13#10#9#9'<Path>scenery\world</Path>'+
                  #13#10#9#9'<Name>RS ALT Files</Name>'+
                  #13#10#9#9'<Layer>3</Layer>'+
                  #13#10#9'</AddOn.Component>'+
                  #13#10#9'<AddOn.Name>RS Common Files</AddOn.Name>'+
                  #13#10#9'<AddOn.Description>Files Common to all Richer Simulations Products. DO NOT EDIT OR REMOVE!</AddOn.Description>'+
                  #13#10#9'<AddOn.Component>'+
                  #13#10#9#9'<Category>Effects</Category>'+
                  #13#10#9#9'<Path>Effects</Path>'+
                  #13#10#9'</AddOn.Component>'+
                  #13#10#9'<AddOn.Component>'+
                  #13#10#9#9'<Category>Texture</Category>'+
                  #13#10#9#9'<Path>Texture</Path>'+
                  #13#10#9'<Type>GLOBAL</Type>'+
                  #13#10#9'</AddOn.Component>'+
                  #13#10'</SimBase.Document>';

        SL.SavetoFile(AddonXML);
      finally
        SL.Free;
      end;

    end;

    //add found products
    SL := TStringList.Create;
    try
      SL.LoadFromFile (AddonXML);

      For x:= 0 to length(nearbyproducts)-1 do
      begin
       {If products[nearbyproducts[x]] <> 'RS Common' then
        begin  }
          If pos(RSproducts[nearbyproducts[x]]+'</Name>', SL.text) = 0 then
            SL.Insert(1,
             #9'<AddOn.Name>'+RSproducts[nearbyproducts[x]]+
             '</AddOn.Name>'#13#10#9'<AddOn.Description>'+RSproducts[nearbyproducts[x]]+
             '</AddOn.Description>'#13#10#9'<AddOn.Component>'#13#10#9#9'<Category>Scenery</Category>'#13#10#9#9'<Path>'+RicherSimsLocation+RSproducts[nearbyproducts[x]]+
             '</Path>'#13#10#9#9'<Name>'+RSproducts[nearbyproducts[x]]+
             '</Name>'#13#10#9#9'<Required>False</Required>'#13#10#9'</AddOn.Component>');
        {end;}
      end;

      //create scenery\world directory if it does not exist
      If not DirectoryExists(RicherSimsLocation+'Scenery\World\Scenery') then
        ForceDirectories(RicherSimsLocation+'Scenery\World\Scenery');

      //add scenery/world if it does not exist in addon.xml
      If pos('scenery\world', SL.text) = 0 then
            SL.Text := StringReplace(SL.text,
             '<SimBase.Document Type="AddOnXml" version="4,0" id="add-on">', '<SimBase.Document Type="AddOnXml" version="4,0" id="add-on">'#13#10#9'<AddOn.Name>RS ALT files'+
             '</AddOn.Name>'#13#10#9'<AddOn.Description>Altitude files for RS Airports: DO NOT EDIT OR REMOVE!'+
             '</AddOn.Description>'#13#10#9'<AddOn.Component>'#13#10#9#9'<Category>Scenery</Category>'#13#10#9#9'<Path>'+RicherSimsLocation+'scenery\world'+
             '</Path>'#13#10#9#9'<Name>RS ALT Files'+
             '</Name>'#13#10#9#9'<Layer>3</Layer>'#13#10#9'</AddOn.Component>', [rfReplaceAll]);




      //Make Scenery Effects, Texture and Autogen paths Absolute
      If DirectoryExists(RicherSimsLocation+'RS Common') then
        SL.Text := StringReplace(SL.text, '<Path>RS Common', '<Path>'+RicherSimsLocation+'RS Common', [rfReplaceAll, rfIgnoreCase]);   //scenery and autogen...
      If DirectoryExists(RicherSimsLocation+'Effects') then
        SL.Text := StringReplace(SL.text, '<Path>Effects', '<Path>'+RicherSimsLocation+'Effects', [rfReplaceAll, rfIgnoreCase]);
      If DirectoryExists(RicherSimsLocation+'Texture') then
        SL.Text := StringReplace(SL.text, '<Path>Texture', '<Path>'+RicherSimsLocation+'Texture', [rfReplaceAll, rfIgnoreCase]);
      If DirectoryExists(RicherSimsLocation+'Scenery') then
        SL.Text := StringReplace(SL.text, '<Path>scenery', '<Path>'+RicherSimsLocation+'scenery', [rfReplaceAll, rfIgnoreCase]);

      SL.SaveToFile(AddonXML);

      RSCommonInstallLocation := FindInstallLocation('RS Common', sceneryCFGpath, simpath, sim);

      //add autogen component if it does not exist
      If UseP3DAutogenSystem then
      begin
        For x:= 1 to SL.Count-1 do
        begin
          If SL.Strings[x].Contains('<AddOn.Name>RS Common</AddOn.Name>') then
          begin
