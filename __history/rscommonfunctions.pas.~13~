function AddToSceneryLibrary(i: integer; SceneryCFG, RSLocation: string): boolean;
var Area, Layer,x,y,z : integer;
    SL: TStringList;
    searchstring, a, l: string;
begin
  result := false;
  //add Product[x] to the bottom of the sceneryCFG
  //first find out what the last entry is
  SL := TStringList.Create;
  try
    If FileExists(SceneryCFG) then
    begin
      SL.LoadFromFile(SceneryCFG);

      If ContainsText(SceneryCFG, 'scenery_packs.ini') then //we are dealing with XPlane11

          SL.Insert(4, 'SCENERY_PACK Custom Scenery/'+RSXPproducts[i]+'/')

      else
      begin

        //find the end of the file
        y := length(SL.Text);
        While SL.Text[y] <> '[' do  //work backwards to first '[Area.xxx]'
          y := y - 1;
        z := PosEx(']', SL.Text, y);
        //read xxx integer at end of [Area.xxx]
        For x := y+length('[Area.') to z-1 do
          a := a + SL.Text[x];
        Area := StrToInt(trim(a));

        //find the 'Layer='
        searchstring:= 'Layer=';
        y := PosEx(searchstring, SL.Text, x)+length(searchstring);
        z := PosEx(sLineBreak, SL.Text, y);
        For x := y to z do
          l := l + SL.Text[x];
        Layer := StrToInt(trim(l));

        //add 1 to last entry
        inc(area);
        inc(layer);

        //add entry
        SL.Text := SL.Text +
        #13#10'[Area.'+IntToStr(Area)+']'+
        #13#10'Title='+RSproducts[i]+
        #13#10'Local='+RicherSimsLocation+RSproducts[i]+
        #13#10'Active=TRUE'+
        #13#10'Required=FALSE'+
        #13#10'Layer='+IntToStr(Layer);

      end;


      SL.SaveToFile(SceneryCFG);
    end;

  finally
    Sl.Free;
  end;

end;

