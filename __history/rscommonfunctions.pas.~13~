function ReturnStringBetween(searchstring, endstring, filename: string): string;
var SL: TStringList;
begin
  result:='';
  SL := TStringList.Create;
  try
    SL.LoadFromFile(filename);
    result := ReturnStringBetweenText(searchstring, endstring, SL.text);
  finally
    SL.Free
  end;
end;

function ReturnStringBetweenText(startstring, endstring, TextToSearch: string): string;
var x,y,z: integer;

begin
  result:='';
  y:= Pos(startstring, TextToSearch)+length(startstring);
  z:= PosEx(endstring,TextToSearch,y);
  If y > length(startstring) then
  begin
    For x := y to z-1 do
       result:= result + TextToSearch[x];
  end;
  result := trim(result);
end;

