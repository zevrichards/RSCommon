function WriteProductLocationToReg(Handle: HWND; product, location: string): boolean;
var myReg: TRegistry;
    RegLocation, RegVersion: string;
    ShOp: TSHFileOpStruct;
begin

  result := false;
  myReg := TRegistry.Create(KEY_ALL_ACCESS{ or KEY_WOW64_64KEY});
  try
    myReg.RootKey := HKEY_LOCAL_MACHINE;
    myReg.OpenKey('\SOFTWARE\Richer Simulations\'+product, true); //If the key does not exist create and open it
    RegLocation := myReg.ReadString('Path');
    RegVersion := myReg.ReadString('Version');

    If RegVersion = '' then
      myReg.WriteString('Version', '1.0.0.0');

    If RegLocation = '' then     //If there is no path then write one
    begin
      myReg.WriteString('Path', location);
      If product = 'RSSCT' then
        myReg.WriteString('Version', GetAppVersionStr(ParamStr(0)));
    end
    else
    begin
      If RegLocation <> location then //If the path in the registry does not match the path passed then
      begin
        If product <> 'RSSCT' then //change it for RS products
          myReg.WriteString('Path', location)
        else
        begin
          If MyMessageDialog('RSSCT has detected that another copy of the tool is installed in: '+sLineBreak+
                             RegLocation+sLineBreak+
                             'Would you like to remove the other copy?',mtInformation,mbYesNo, ['Yes', 'No']) = mrYes then //or prompt the user of multiple RSSCT installation and preferred action
          begin
            //delete folder
            ShOp.Wnd := Handle;
            ShOp.wFunc := FO_DELETE;
            ShOp.pFrom := PChar(LeftStr(RegLocation, length(RegLocation)-length('RSSCT.exe'))+#0);
            ShOp.pTo := nil;
            ShOp.fFlags := FOF_NOCONFIRMATION or FOF_ALLOWUNDO;
            SHFileOperation(ShOp);
            myReg.WriteString('Path', location);
            myReg.WriteString('Version', GetAppVersionStr(ParamStr(0)));
          end;
        end;
      end;
    end;

    myReg.CloseKey();
    result := true;
  finally
    myReg.Free;
  end;
end;

