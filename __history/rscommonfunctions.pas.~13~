function DeegreesMinutesToDecimalDegrees(s: string): string;
var degrees, minutes: string;
    D, dd: real;
begin
  //split string into degrees and minutes
  degrees := ReturnStringBetweenText(s[1],' ', s);
  minutes := RightStr(s,length(s)-length(degrees)-2);
  //convert minutes to decimal by dividing by 60
  dd := StrToFloat(minutes)/60;
  //convert number to positive or negative based on first letter
  D := StrToInt(degrees)+dd;

  If ((lowercase(s[1])='s') or (lowercase(s[1])='w')) then
    D := D*-1;

  result := FloatToStr(D);
end;

